# ============================================
# Emotion Classification & Interpretation API
# Environment Variables Configuration
# ============================================
# 
# Copy file ini ke .env dan sesuaikan nilai-nilainya.
# Semua default values sesuai dengan app/core/config.py
#
# Usage:
#   cp .env.example .env
#   # Edit .env sesuai kebutuhan
# ============================================

# ============================================
# HuggingFace API Configuration
# ============================================
# Token untuk akses HuggingFace Hub dan Inference API
# Recommended: Set token untuk faster download dan better rate limits
# Dapatkan token di: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
HUGGINGFACE_API_KEY=your_huggingface_token_here

# ============================================
# Model Configuration
# ============================================
# Model ID untuk emotion classifier (HuggingFace Hub)
# Default: qrizan/emotion-classifier-indonesia
MODEL_ID=qrizan/emotion-classifier-indonesia

# Model path untuk runtime (bisa sama dengan MODEL_ID atau path lokal)
# Default: qrizan/emotion-classifier-indonesia
MODEL_PATH=qrizan/emotion-classifier-indonesia

# ============================================
# Embedding Model Configuration
# ============================================
# Model name untuk embedding/semantic similarity (via HuggingFace Inference API)
# Default: intfloat/multilingual-e5-small
# Alternatif: intfloat/multilingual-e5-base, intfloat/multilingual-e5-large
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

# ============================================
# Processing Configuration
# ============================================
# Maximum token length untuk tokenization
# Default: 128
# Range: 32-512 (sesuai model)
MAX_LENGTH=128

# Confidence threshold untuk interpretasi
# Default: 0.60
# Range: 0.0-1.0
# Jika confidence < threshold, interpretasi tidak diberikan
CONFIDENCE_THRESHOLD=0.60

# ============================================
# Download Configuration (Build Time)
# ============================================
# Jumlah retry jika download model gagal
# Default: 3
MAX_RETRIES=3

# Delay antar retry dalam detik
# Default: 10
# Delay akan bertambah: RETRY_DELAY * attempt_number (exponential backoff)
RETRY_DELAY=10

# ============================================
# Optional: HuggingFace Cache Configuration
# ============================================
# Path untuk HuggingFace cache (untuk Docker)
# Default: /app/.cache/huggingface (dalam container)
# HF_HOME=/app/.cache/huggingface
